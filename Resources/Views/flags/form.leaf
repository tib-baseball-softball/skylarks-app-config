<button commandfor="flags-dialog" command="show-modal" class="btn primary">
  Create new
</button>

<dialog id="flags-dialog" closedby="any">
  
  <form method="post" action="/flags/create">
    <label for="input-key">Name</label>
    <input id="input-key" type="text" name="key" required />

    <label for="input-description">Description</label>
    <input id="input-description" type="text" name="description" />

    <button class="btn primary" type="submit">Submit</button>
  </form>
</dialog>