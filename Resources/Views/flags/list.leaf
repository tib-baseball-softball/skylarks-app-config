#extend("layout"): #export("main"):
<div class="flags-table">
  <h1>Feature Flags</h1>
  
  <table>
    <thead>
      <th>Key</th>
      <th>Description</th>
    </thead>
    
    <tbody>
      #for(flag in flags):
        <tr>
          <td>#(flag.key)</td>
          <td>#(flag.description)</td>
        </tr>
      #endfor
      
      #if(flags.isEmpty):
          <tr>There are no feature flags yet.</tr>
      #endif
    </tbody>
  </table>
  
  #extend("flags/form")
    
</div>
#endexport #endextend
