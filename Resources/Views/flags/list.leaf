#extend("layout"): #export("main"):
<div class="flags-table">
  <h1>Feature Flags</h1>
  
  <table>
    <thead>
      <th>Key</th>
      <th>Description</th>
      <th>Actions</th>
    </thead>
    
    <tbody>
      #for(flag in flags):
        <tr>
          <td>#(flag.key)</td>
          <td>#(flag.description)</td>
          <td>
            <button
              commandfor="delete-flag-dialog-#(flag.id)"
              command="show-modal"
              class="btn"
              type="button"
            >
              Delete
            </button>
            
            <dialog id="delete-flag-dialog-#(flag.id)" closedby="any">
              <form method="POST" action="/flags/#(flag.id)/delete">
                <p>Confirm deleting feature flag "#(flag.key)?"</p>
                <button class="btn delete-button" type="submit">Delete</button>
              </form>
            </dialog>
          </td>
        </tr>
      #endfor
      
      #if(flags.isEmpty):
          <tr>There are no feature flags yet.</tr>
      #endif
    </tbody>
  </table>
  
  #extend("flags/form")
    
</div>
#endexport #endextend
