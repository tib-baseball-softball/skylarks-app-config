#extend("layout"): #export("main"):
<div class="configs-list">
  <h1>Configuration "#(config.name)"</h1>

  <article class="card" id="config-main-container" data-config="#(config.id)">
    <dl class="config-card-grid">
      <dt>
        <strong>Application Context</strong>
      </dt>
      <dd>
        <code>#(config.applicationContext)</code>
      </dd>

      <dt>
        <strong>Name</strong>
      </dt>
      <dd>#(config.name)</dd>

      <dt>
        <strong>Description</strong>
      </dt>
      <dd>#(config.description)</dd>

      <dt>
        <strong>BSM Base URL</strong>
      </dt>
      <dd>
        <a href="#(config.apiURLS.bsmURL)" target="_blank"
          >#(config.apiURLS.bsmURL)</a
        >
      </dd>

      <dt>
        <strong>TYPO3 CMS Base URL</strong>
      </dt>
      <dd>
        <a href="#(config.apiURLS.cmsURL)" target="_blank"
          >#(config.apiURLS.cmsURL)</a
        >
      </dd>

      <dt>
        <strong>Diamond Planner Base URL</strong>
      </dt>
      <dd>
        <a href="#(config.apiURLS.dpURL)" target="_blank"
          >#(config.apiURLS.dpURL)</a
        >
      </dd>
    </dl>
  </article>

  <h2>Feature Flags for this Configuration</h2>
  #extend("partials/configFlagGridItem")

  <div class="link-box">
    <a class="btn" href="/configs/#(config.id)/formUpdate">Edit</a>
    <button
      commandfor="delete-config-dialog"
      command="show-modal"
      class="btn"
      type="button"
    >
      Delete
    </button>
  </div>

  <dialog id="delete-config-dialog" closedby="any">
    <form method="POST" action="/configs/#(config.id)/delete">
      <p>Confirm deleting configuration "#(config.name)?"</p>
      <button class="btn delete-button" type="submit">Delete</button>
    </form>
  </dialog>
</div>
#endexport #endextend
