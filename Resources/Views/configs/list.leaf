#extend("layout"): #export("main"):
<div class="configs-list">
  <h1>Available Configurations</h1>
  <ul class="configs-grid">
    #for(config in configs):
    <li>
      <article class="card">#(config.description), #(config.name)</article>
      <a href="/configs/#(config.id)/formUpdate">Edit</a>
    </li>
    #endfor
  </ul>
  <a class="btn primary" href="/configs/form">Create new</a>
</div>
#endexport #endextend
