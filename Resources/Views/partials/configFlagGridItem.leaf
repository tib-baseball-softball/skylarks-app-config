<article class="card flags-card" id="config-flags-container">
  #for(flagRel in config.flagRelations):
  <div><code>#(flagRel.flag.key)</code></div>
  <div class="flag-desc">#(flagRel.flag.description)</div>
  <div class="flag-enabled-box">
    #if(flagRel.enabled == true):
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon-enabled"
    >
      <path
        d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"
      />
      <path d="m9 12 2 2 4-4" />
    </svg>
    <span>On</span>
    #else:
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon-disabled"
    >
      <path
        d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"
      />
      <line x1="8" x2="16" y1="12" y2="12" />
    </svg>
    <span>Off</span>
    #endif
  </div>
  <form
    method="POST"
    action="/flag-relations/upsert"
    class="flag-relation-form reset-form"
  >
    <input type="hidden" name="flagID" value="#(flagRel.flag.id)" />
    <input type="hidden" name="configID" value="#(config.id)" />
    #if(flagRel.enabled):
    <input type="hidden" name="enabled" value="false" />
    #else:
    <input type="hidden" name="enabled" value="true" />
    #endif
    <button type="submit" class="btn flag-toggle">Toggle</button>
  </form>
  #endfor
</article>

<template id="flag-item-template">
  <div><code data-replace></code></div>
  <div data-replace class="flag-desc"></div>
  <div class="flag-enabled-box">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon-questionable"
    >
      <path
        d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"
      />
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
      <line x1="12" x2="12.01" y1="17" y2="17" />
    </svg>
    <span>No relation</span>
  </div>
  
  <form
    method="POST"
    action="/flag-relations/upsert"
    class="flag-relation-form reset-form"
  >
    <input data-replace type="hidden" name="flagID" value="" />
    <input data-replace type="hidden" name="configID" value="" />
    <input type="hidden" name="enabled" value="true" />
    <button type="submit" class="btn flag-toggle">Enable</button>
  </form>
</template>

<script src="/js/config-detail-page.js"></script>