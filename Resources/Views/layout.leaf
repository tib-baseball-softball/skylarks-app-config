<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/berlin-skylarks-theme@latest/theme.min.css"
    />
    <link rel="stylesheet" href="/css/main.css" />

    <title>#(title)</title>
  </head>

  <body>
    #extend("layout/header")

    <hr />

    <div class="nav-grid">
      #extend("layout/navbar")
      <main>
        #import("main")
      </main>
    </div>
  </body>

  <hr />

  #extend("layout/footer")
</html>
